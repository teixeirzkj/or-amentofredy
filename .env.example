# Chave da API da Anthropic (usada só no servidor, nunca vai pro navegador)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado pra ler o print. Padrão: claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# Porta do servidor
PORT=3000

# URL pública (usada pra montar o link enviado ao cliente). Sem barra no final.
PUBLIC_URL=http://localhost:3000

# Senha de acesso do atendente ao gerador. Se vazio, o gerador fica aberto (só use em rede interna).
ATTENDANT_TOKEN=

# Segredo pra assinar o cookie de sessão (qualquer texto longo e aleatório)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Quem pode abrir o gerador dentro de um iframe (pra embutir no Frédy depois).
# Ex.: self https://app.seudominio.com.br
FRAME_ANCESTORS=self

# --- Vercel ---
# Na Vercel não existe disco persistente. Crie um Blob Store no projeto (Storage → Blob):
# a Vercel cria BLOB_STORE_ID (OIDC) ou BLOB_READ_WRITE_TOKEN e o app passa a guardar propostas e fotos lá.
# BLOB_READ_WRITE_TOKEN=
# Pasta dentro do store (opcional)
# BLOB_PREFIX=fredy-orcamentos/

# --- Fotos automáticas (opcional, mas deixa a proposta muito mais bonita) ---
# Fotos do hotel, 1ª opção: Google Places API (New) — fotos do Google Maps, sempre do hotel certo, e o endereço.
# console.cloud.google.com → projeto → Faturamento → APIs e serviços → Biblioteca → "Places API (New)" → Ativar
# → Credenciais → Chave de API (restrinja à Places API (New)). Ponha um teto diário em "Cotas" pra nunca sair do grátis.
GOOGLE_PLACES_API_KEY=
# Fotos do hotel, reserva (usada quando o Places bate o teto ou não acha fotos): SerpApi. Grátis: 250 buscas/mês, sem cartão.
# serpapi.com → Register (e-mail + confirmação) → Dashboard / Api Key → copie a chave.
SERPAPI_API_KEY=
# Foto de capa do destino: Unsplash (unsplash.com/developers → New Application → Access Key)
UNSPLASH_ACCESS_KEY=
# ou Pexels (pexels.com/api → Your API Key). Se os dois estiverem definidos, o Unsplash é usado.
PEXELS_API_KEY=
